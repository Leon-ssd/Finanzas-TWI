@using System.Security.Claims
@using FinanzasPersonales.Api.Authentication
@{
    Layout = null;
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Finanzas-TWI — Inicio de sesión Dev3</title>
</head>
<body>
    <main>
        <h1>Finanzas-TWI — Inicio de sesión</h1>
        @if (ViewData["Error"] is string error)
        {
            <p role="alert">@error</p>
        }
        <section aria-label="Proveedores externos">
            <form method="post" action="@Url.Content("~/auth/dropbox/login")">
                @Html.AntiForgeryToken()
                <button type="submit">Iniciar sesión con Dropbox</button>
                @if (ViewData["DropboxConfigured"] is not true)
                {
                    <span>Pendiente de configurar credenciales.</span>
                }
            </form>
            <form method="post" action="@Url.Content("~/auth/microsoft/login")">
                @Html.AntiForgeryToken()
                <button type="submit">Iniciar sesión con Microsoft</button>
                @if (ViewData["MicrosoftConfigured"] is not true)
                {
                    <span>Pendiente de configurar credenciales.</span>
                }
            </form>
        </section>
        <section aria-label="Sesión local">
            <h2>Identidad autenticada</h2>
            @if (authenticated)
            {
                <dl>
                    <dt>Proveedor</dt><dd>@User.FindFirstValue(Dev3Authentication.ProviderClaim)</dd>
                    <dt>Identificador externo</dt><dd>@User.FindFirstValue(ClaimTypes.NameIdentifier)</dd>
                    <dt>Nombre</dt><dd>@User.Identity?.Name</dd>
                    <dt>Correo disponible</dt><dd>@(User.FindFirstValue(ClaimTypes.Email) ?? User.FindFirstValue("email") ?? "No proporcionado")</dd>
                </dl>
            }
            else
            {
                <p>No hay una sesión local activa.</p>
            }
            <form method="post" action="@Url.Content("~/auth/dev3/logout")">
                @Html.AntiForgeryToken()
                <button type="submit">Cerrar sesión</button>
            </form>
            <p>El cierre de sesión es local; no cierra tu cuenta en Dropbox o Microsoft.</p>
        </section>
    </main>
</body>
</html>


# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA DE FINANZAS PERSONALES (.NET 10 & PostgreSQL)
# ==============================================================================

# Conexión a Base de Datos PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=finanzas_db;Username=postgres;Password=postgres

# ------------------------------------------------------------------------------
# INTEGRANTE 2: Autenticación OAuth 2.0 (Twitch y Spotify)
# ------------------------------------------------------------------------------

# Proveedor Lista Fácil: Twitch
# Panel de desarrolladores: https://dev.twitch.tv/console/apps
# OAuth Redirect URL configurada en Twitch: https://localhost:7001/signin-twitch (o http://localhost:5257/signin-twitch)
AUTH__TWITCH__CLIENTID=tu_twitch_client_id_aqui
AUTH__TWITCH__CLIENTSECRET=tu_twitch_client_secret_aqui
AUTH__TWITCH__CALLBACKPATH=/signin-twitch

# Proveedor Lista Media: Spotify
# Panel de desarrolladores: https://developer.spotify.com/dashboard
# Redirect URI configurada en Spotify: https://localhost:7001/signin-spotify (o http://localhost:5257/signin-spotify)
AUTH__SPOTIFY__CLIENTID=tu_spotify_client_id_aqui
AUTH__SPOTIFY__CLIENTSECRET=tu_spotify_client_secret_aqui
AUTH__SPOTIFY__CALLBACKPATH=/signin-spotify
# Plantilla sin credenciales. Copiar a .env (ignorado por Git) y completar.
# .NET no carga .env automáticamente: ver instrucciones del README.
# Dropbox: ClientId = App key; ClientSecret = App secret.
Authentication__Dropbox__ClientId=
Authentication__Dropbox__ClientSecret=
Authentication__Dropbox__CallbackPath=/auth/dropbox/callback
# Microsoft: Application (client) ID y el VALOR del secreto, no su identificador.
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
# common: cuentas personales + organizaciones (debe coincidir con el registro).
# También se permite consumers, organizations o el GUID de un tenant concreto.
Authentication__Microsoft__TenantId=common
Authentication__Microsoft__CallbackPath=/auth/microsoft/callback

# Punto 3 Dev3: vinculación explícita, administrada SOLO en el servidor.
# Descomentar y completar con identidades REALES y un Usuario.Id existente/activo.
# Obtener IdentificadorExterno del campo id de /auth/dev3/session tras login real.
# No usar correo para vincular, no enviar estos datos en los POST financieros.
# Dev3__VinculosIdentidad__0__Proveedor=Dropbox
# Dev3__VinculosIdentidad__0__IdentificadorExterno='IDENTIFICADOR_EXTERNO_REAL_DROPBOX'
# Dev3__VinculosIdentidad__0__UsuarioId=GUID_LOCAL_REAL
# Dev3__VinculosIdentidad__1__Proveedor=Microsoft
# Dev3__VinculosIdentidad__1__IdentificadorExterno='EMISOR_REAL|SUB_REAL'
# Dev3__VinculosIdentidad__1__UsuarioId=GUID_LOCAL_REAL
